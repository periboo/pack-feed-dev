{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/event-companion/schemas/manifest.schema.json",
  "title": "Event Companion Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "coverage_id",
    "updated_at",
    "packs"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "coverage_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "etag": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string"
          },
          "refresh_hint": {
            "type": "string"
          },
          "volatility": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
