{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/event-companion/schemas/pack.schema.json",
  "title": "Event Companion Event Pack",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "area",
    "updated_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string"
    },
    "valid_until": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "starts_at",
          "venue_name",
          "latitude",
          "longitude"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "starts_at": {
            "type": "string"
          },
          "ends_at": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "venue_name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "location_confidence": {
            "type": "number"
          },
          "summary": {
            "type": "string"
          },
          "source_name": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "event_confidence": {
            "type": "number"
          },
          "source_confidence": {
            "type": "number"
          },
          "data_quality": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
